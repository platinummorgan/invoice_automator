{
  "expo": {
    "name": "Swift Invoice",
    "slug": "invoice-automator",
    "scheme": "com.invoiceautomator.app",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.invoiceautomator.app",
      "buildNumber": "16",
      "scheme": "com.invoiceautomator.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B6C53"
      },
      "package": "com.invoiceautomator.app",
      "permissions": [
        "READ_CONTACTS",
        "NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.invoiceautomator.app",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Swift Invoice to access your photos so you can add job pictures and upload a business logo."
        }
      ],
      "expo-mail-composer",
      "react-native-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.android.vending.billing.** { *; }",
            "extraMavenRepos": [
              "https://maven.google.com"
            ]
          }
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "884636010114-k636nc5f4397hve5vmfj765m9o9rsbgj.apps.googleusercontent.com",
      "eas": {
        "projectId": "aa2671dc-1b44-44d2-a195-a054122ea0d1"
      }
    }
  }
}
